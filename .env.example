# Frontend / renderer
VITE_API_BASE=http://127.0.0.1:8000
VITE_SERVER_BASE=tcp://127.0.0.1:8888

# Backend
# Example only. Do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DB_NAME
JWT_SECRET=replace-with-a-long-random-secret-before-any-public-or-shared-test
TRICLOUD_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DATA_SERVER_ENDPOINT=tcp://127.0.0.1:8888
NODE_SERVER_ENDPOINT=tcp://127.0.0.1:9999
NODE_STORAGE_DIR_DEFAULT=./node_store
NODE_RUNNER_FILE=node_phase1_runner.py
CLIENT_ENDPOINT=tcp://*:8888
NODE_ENDPOINT=tcp://*:9999
REQUIRE_NODE_API_KEY=1
OBJECT_GC_POLL_SEC=5
TRASH_RETENTION_DAYS=30

# Phase 2: separate administration API / web console.
# Use a different high-entropy value from JWT_SECRET in production.
ADMIN_JWT_SECRET=replace-with-a-different-long-random-admin-secret
ADMIN_SESSION_TTL_SEC=900
ADMIN_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174
# Prefer the explicit migration script. Automatic DDL is off by default.
ADMIN_AUTO_MIGRATE=0
# Turn on only after migrate_phase2_admin.py succeeds and both APIs are deployed.
PHASE2_ADMIN_CONTROLS_ENABLED=0

# Phase 1: data-integrity foundation (reliability scoring is intentionally excluded).
DOWNLOAD_NODE_TIMEOUT_SEC=4
DOWNLOAD_MAX_REPLICA_ATTEMPTS=3
TARGET_REPLICA_COUNT=3
REPLICA_ONLINE_WINDOW_SEC=20
REPLICA_LONG_OFFLINE_SEC=604800
REPLICA_AUDIT_VALID_SEC=259200
REPLICA_HEALTH_SCAN_INTERVAL_SEC=300
REPLICA_HEALTH_SCAN_LIMIT=1000
# Safe rollout defaults: detection only.  Enable each stage explicitly in a
# verification environment after reviewing the preceding stage.
REPLICA_REPAIR_QUEUE_ENABLED=0
REPLICA_REQUIRE_RECENT_AUDIT=0
STORAGE_AUDIT_ENABLED=0
AUDIT_SCHEDULE_INTERVAL_SEC=5
AUDIT_TARGET_AGE_SEC=259200
AUDIT_TIMEOUT_SEC=8
AUDIT_MAX_INFLIGHT=16
AUDIT_SCHEDULE_BATCH=4
AUDIT_MAX_ATTEMPTS=3
AUDIT_RETRY_DELAYS_SEC=30,300,1800
AUDIT_MISMATCH_CORRUPT_THRESHOLD=2
AUDIT_SLICE_LEN=1024
AUDIT_SLICES_PER_CHUNK=3
REPLICA_REPAIR_EXECUTION_ENABLED=0
REPAIR_POLL_INTERVAL_SEC=1
REPAIR_MAX_INFLIGHT=2
REPAIR_MAX_ATTEMPTS=4
REPAIR_MAX_SOURCE_ATTEMPTS=3
REPAIR_SOURCE_AUDIT_VALID_SEC=259200
REPAIR_STEP_TIMEOUT_SEC=15
REPAIR_LEASE_SEC=60
REPAIR_RETRY_DELAYS_SEC=30,300,1800
REPAIR_PROGRESS_FLUSH_BYTES=67108864
REPAIR_CLEANUP_BATCH=20
# Optional per-node label, e.g. provider-a/region-a/rack-2.  A known domain is
# not reused for another replica of the same object.
TRICLOUD_NODE_FAILURE_DOMAIN=

# Stripe is disabled in the public beta unless these are explicitly configured in a private .env.local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
